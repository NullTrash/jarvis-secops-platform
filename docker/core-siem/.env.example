# ==============================================================================
# Jarvis Core SIEM Environment Configuration (Proxmox VM 1)
# ==============================================================================

# Elastic Stack Version
ELASTIC_VERSION=8.17.0

# Memory Allocations
# Recommended: 4g for ES Heap if dedicating 8-10GB RAM to this VM
ES_HEAP_SIZE=4g

# Passwords & Encryption Keys (Change these for production!)
ELASTIC_PASSWORD=ChangemeSecurePass2026!
KIBANA_ENCRYPTION_KEY=generate_secure_32_byte_hex_key_here

# Exposed Ports
ES_PORT=9200
KIBANA_PORT=5601
UNIFI_SYSLOG_PORT=514
SYSMON_BEAT_PORT=5044
