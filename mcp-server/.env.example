# ==============================================================================
# Elastic SIEM Configuration
# ==============================================================================
ELASTIC_HOST=10.0.0.20
ELASTIC_PORT=9200
ELASTIC_USER=elastic
ELASTIC_PASSWORD=ChangemeSecurePass2026!
ELASTIC_USE_SSL=false

# ==============================================================================
# Proxmox VE REST API Configuration
# ==============================================================================
PROXMOX_HOST=10.0.0.10
PROXMOX_PORT=8006
PROXMOX_VERIFY_SSL=false

# Option A: API Token (Recommended - Datacenter -> Permissions -> API Tokens)
PROXMOX_TOKEN_ID=secops-agent@pve!jarvis-token
PROXMOX_TOKEN_SECRET=00000000-0000-0000-0000-000000000000

# Option B: User / Password Fallback
PROXMOX_USER=jarvis
PROXMOX_PASSWORD=

# ==============================================================================
# Ollama GPU Compute Node
# ==============================================================================
OLLAMA_HOST=10.0.0.20
OLLAMA_PORT=11434

# ==============================================================================
# Threat Intelligence Feeds (Optional - local heuristics used as fallback)
# ==============================================================================
# AbuseIPDB API v2: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# VirusTotal API v3: https://www.virustotal.com/gui/user/<username>/apikey
VIRUSTOTAL_API_KEY=

# ==============================================================================
# Threat Intel Pipeline, Environment Profile & Identity OSINT Watchlist
# ==============================================================================
ENVIRONMENT_PROFILE=config/environment-profile.json
IDENTITY_WATCH_NAMES=SecOps Admin
IDENTITY_WATCH_EMAILS=secops-admin@example.com
IDENTITY_WATCH_USERNAMES=secops-handle
