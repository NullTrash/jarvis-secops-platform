{
  "rule_id": "jarvis-4682fd2c-cfae-47ed-a543-9bed37657aa6",
  "name": "[Jarvis] Potential Local NTLM Relay via HTTP",
  "description": "Identifies attempts to coerce local NTLM authentication over HTTP through WebDAV named-pipe paths such as\nPrint Spooler or SRVSVC. Adversaries can combine this primitive with relay tooling to elevate privileges.\n",
  "risk_score": 73,
  "severity": "high",
  "type": "eql",
  "language": "eql",
  "index": [
    "winlogbeat-*",
    "logs-endpoint.sysmon-*",
    "logs-network.unifi-default"
  ],
  "query": "process where host.os.type == \"windows\" and event.type == \"start\" and\n  process.name : \"rundll32.exe\" and\n\n  /* Rundll32 WbeDav Client  */\n  process.args : (\"?:\\\\Windows\\\\System32\\\\davclnt.dll,DavSetCookie\", \"?:\\\\Windows\\\\SysWOW64\\\\davclnt.dll,DavSetCookie\") and\n\n  /* Access to named pipe via http */\n  process.args : (\"http*/print/pipe/*\", \"http*/pipe/spoolss\", \"http*/pipe/srvsvc\")",
  "from": "now-15m",
  "interval": "10m",
  "enabled": true,
  "tags": [
    "Performance: Normal",
    "Tactic: Credential Access",
    "Data Source: Windows Security Event Logs",
    "Data Source: Crowdstrike",
    "Tactic: Defense Evasion",
    "Rule Type: Event Correlation (EQL)",
    "Threat: Living off the Land",
    "Platform: Windows",
    "Data Source: Elastic Endgame",
