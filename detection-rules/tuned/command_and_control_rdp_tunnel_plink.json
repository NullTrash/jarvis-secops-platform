{
  "rule_id": "jarvis-76fd43b7-3480-4dd9-8ad7-8bd36bfad92f",
  "name": "[Jarvis] Potential Remote Desktop Tunneling Detected",
  "description": "Identifies potential use of an SSH utility to establish RDP over an SSH Tunnel. This can be used by attackers to enable\nrouting of network packets that would otherwise not reach their intended destination.\n",
  "risk_score": 73,
  "severity": "high",
  "type": "eql",
  "language": "eql",
  "index": [
    "winlogbeat-*",
    "logs-endpoint.sysmon-*",
    "logs-network.unifi-default"
  ],
  "query": "process where host.os.type == \"windows\" and event.type == \"start\" and\n  /* RDP port with SSH local or reverse port-forwarding flags */\n  process.args : \"*:3389\" and process.args : (\"-L\", \"-R\")",
  "from": "now-15m",
  "interval": "10m",
  "enabled": true,
  "tags": [
    "Performance: Normal",
    "Data Source: Windows Security Event Logs",
    "Data Source: Crowdstrike",
    "Rule Type: Event Correlation (EQL)",
    "Platform: Windows",
    "Data Source: Elastic Endgame",
    "Jarvis-Curated",
    "Domain: Endpoint",
    "Tactic: Command and Control",
    "Homelab-Tuned",
    "Noise: Medium",
