{
  "rule_id": "jarvis-b8386923-b02c-4b94-986a-d223d9b01f88",
  "name": "[Jarvis] PowerShell Invoke-NinjaCopy script",
  "description": "Detects PowerShell script block content containing Invoke-NinjaCopy or related Stealth* functions used for direct volume\nfile access. Attackers use NinjaCopy to read locked system files such as NTDS.dit or registry hives for credential\ndumping.\n",
  "risk_score": 73,
  "severity": "high",
  "type": "query",
  "language": "kuery",
  "index": [
    "winlogbeat-*",
    "logs-endpoint.sysmon-*",
    "logs-network.unifi-default"
  ],
  "query": "event.category:process and host.os.type:windows and\n  powershell.file.script_block_text : (\n    \"StealthReadFile\" or\n    \"StealthReadFileAddr\" or\n    \"StealthCloseFileDelegate\" or\n    \"StealthOpenFile\" or\n    \"StealthCloseFile\" or\n    \"Invoke-NinjaCopy\"\n   ) and\n  not powershell.file.script_block_text : (\n    \"sentinelbreakpoints\" and \"Set-PSBreakpoint\" and \"PowerSploitIndicators\"\n  )",
  "from": "now-15m",
  "interval": "10m",
  "enabled": true,
  "tags": [
    "Platform: Windows",
    "Performance: Normal",
    "Tactic: Credential Access",
    "Data Source: PowerShell Logs",
    "Jarvis-Curated",
    "Domain: Endpoint",
    "Resources: Investigation Guide",
    "Noise: Low",
    "Homelab-Tuned",
    "OS: Windows",
    "Rule Type: Custom Query (KQL)",
    "Use Case: Threat Detection"
  ],
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "technique": [
