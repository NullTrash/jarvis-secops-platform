{
  "rule_id": "jarvis-9d110cb3-5f4b-4c9a-b9f5-53f0a1707ae5",
  "name": "[Jarvis] Potential Credential Access via Trusted Developer Utility",
  "description": "An instance of MSBuild, the Microsoft Build Engine, loaded DLLs (dynamically linked libraries) responsible for Windows\ncredential management. This technique is sometimes used for credential dumping.\n",
  "risk_score": 73,
  "severity": "high",
  "type": "eql",
  "language": "eql",
  "index": [
    "winlogbeat-*",
    "logs-endpoint.sysmon-*",
    "logs-network.unifi-default"
  ],
  "query": "sequence by process.entity_id\n [process where host.os.type == \"windows\" and event.type == \"start\" and (process.name : \"MSBuild.exe\" or process.pe.original_file_name == \"MSBuild.exe\")]\n [library where host.os.type == \"windows\" and dll.name : (\"vaultcli.dll\", \"SAMLib.DLL\")]",
  "from": "now-15m",
  "interval": "10m",
  "enabled": true,
  "tags": [
    "Platform: Windows",
    "Data Source: Sysmon",
    "Performance: Normal",
    "Tactic: Credential Access",
    "Jarvis-Curated",
    "Domain: Endpoint",
    "Resources: Investigation Guide",
    "Homelab-Tuned",
    "OS: Windows",
    "Data Source: Elastic Defend",
    "Use Case: Threat Detection",
    "Tactic: Defense Evasion",
    "Rule Type: Event Correlation (EQL)",
    "Noise: Medium"
  ],
  "threat": [
