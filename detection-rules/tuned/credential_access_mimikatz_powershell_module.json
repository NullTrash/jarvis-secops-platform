{
  "rule_id": "jarvis-ac96ceb8-4399-4191-af1d-4feeac1f1f46",
  "name": "[Jarvis] Potential Invoke-Mimikatz PowerShell Script",
  "description": "Identifies PowerShell script block content containing Invoke-Mimikatz or Mimikatz commands used to dump credentials,\nextract password stores, export certificates, or use alternate authentication material. These patterns can indicate\nin-memory credential access and require reconstructed script context and follow-on telemetry to assess impact.\n",
  "risk_score": 99,
  "severity": "critical",
  "type": "query",
  "language": "kuery",
  "index": [
    "winlogbeat-*",
    "logs-endpoint.sysmon-*",
    "logs-network.unifi-default"
  ],
  "query": "event.category:process and host.os.type:windows and\npowershell.file.script_block_text:(\n  (DumpCreds and DumpCerts) or\n  \"sekurlsa::logonpasswords\" or\n  \"sekurlsa::ekeys\" or\n  \"sekurlsa::tickets\" or\n  \"sekurlsa::pth\" or\n  \"sekurlsa::minidump\" or\n  \"lsadump::sam\" or\n  \"lsadump::secrets\" or\n  \"lsadump::cache\" or\n  \"lsadump::dcsync\" or\n  \"vault::cred\" or\n  \"dpapi::cred\" or\n  (\"crypto::certificates\" and\n  \"CERT_SYSTEM_STORE_LOCAL_MACHINE\")\n)",
  "from": "now-15m",
  "interval": "10m",
  "enabled": true,
  "tags": [
    "Platform: Windows",
    "Performance: Normal",
    "Tactic: Credential Access",
    "Data Source: PowerShell Logs",
    "Jarvis-Curated",
    "Resources: Investigation Guide",
    "Domain: Endpoint",
    "Profile: Recommended",
    "Noise: Low",
    "Homelab-Tuned",
    "OS: Windows",
    "Rule Type: Custom Query (KQL)",
    "Use Case: Threat Detection"
  ],
