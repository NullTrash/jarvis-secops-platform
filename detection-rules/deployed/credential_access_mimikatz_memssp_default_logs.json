{
  "rule_id": "jarvis-ebb200e8-adf0-43f8-a0bb-4ee5b5d852c6",
  "name": "[Jarvis] Mimikatz Memssp Log File Detected",
  "description": "Identifies the default Mimikatz MemSSP credential log file, mimilsa.log. This file is created after the misc::memssp\nmodule injects a malicious Security Support Provider into LSASS and can contain credentials from subsequent logons to\nthe host.\n",
  "risk_score": 73,
  "severity": "high",
  "type": "eql",
  "language": "eql",
  "index": [
    "winlogbeat-*",
    "logs-endpoint.sysmon-*",
    "logs-network.unifi-default"
  ],
  "query": "file where host.os.type == \"windows\" and file.name : \"mimilsa.log\" and process.name : \"lsass.exe\"",
  "from": "now-15m",
  "interval": "10m",
  "enabled": true,
  "tags": [
    "Platform: Windows",
    "Data Source: Elastic Endgame",
    "Data Source: Sysmon",
    "Data Source: Microsoft Defender XDR",
    "Tactic: Credential Access",
    "Performance: Normal",
    "Jarvis-Curated",
    "Resources: Investigation Guide",
    "Domain: Endpoint",
    "Data Source: SentinelOne",
    "Data Source: Crowdstrike",
    "Homelab-Tuned",
    "OS: Windows",
    "Data Source: Elastic Defend",
    "Use Case: Threat Detection",
    "Rule Type: Event Correlation (EQL)",
    "Noise: Medium"
  ],
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "technique": [
        {
          "id": "T1003",
          "name": "OS Credential Dumping",
          "reference": "https://attack.mitre.org/techniques/T1003/"
        },
        {
          "id": "T1556",
          "name": "Modify Authentication Process",
          "reference": "https://attack.mitre.org/techniques/T1556/"
        }
      ],
      "tactic": {
        "id": "TA0006",
        "name": "Credential Access",
        "reference": "https://attack.mitre.org/tactics/TA0006/"
      }
    },
    {
      "framework": "MITRE ATT&CK",
      "technique": [
        {
          "id": "T1547",
          "name": "Boot or Logon Autostart Execution",
          "reference": "https://attack.mitre.org/techniques/T1547/",
          "subtechnique": [
            {
              "id": "T1547.005",
              "name": "Security Support Provider",
              "reference": "https://attack.mitre.org/techniques/T1547/005/"
            }
          ]
        }
      ],
      "tactic": {
        "id": "TA0003",
        "name": "Persistence",
        "reference": "https://attack.mitre.org/tactics/TA0003/"
      }
    }
  ]
