{
  "rule_id": "jarvis-f909075d-afc7-42d7-b399-600b94352fd9",
  "name": "[Jarvis] Untrusted DLL Loaded by Azure AD Connect Authentication Agent",
  "description": "Identifies the load of an untrusted DLL by the Azure AD Connect Authentication Agent, which may\nindicate an attempt to persist or intercept credentials passing through the Pass-through Authentication service.\n",
  "risk_score": 73,
  "severity": "high",
  "type": "eql",
  "language": "eql",
  "index": [
    "winlogbeat-*",
    "logs-endpoint.sysmon-*",
    "logs-network.unifi-default"
  ],
  "query": "library where host.os.type == \"windows\" and process.name : \"AzureADConnectAuthenticationAgentService.exe\" and\n\nnot dll.code_signature.trusted == true and\nnot dll.path : (\n    \"?:\\\\Windows\\\\assembly\\\\NativeImages*\",\n    \"?:\\\\Windows\\\\Microsoft.NET\\\\*\",\n    \"?:\\\\Windows\\\\WinSxS\\\\*\",\n    \"?:\\\\Windows\\\\System32\\\\DriverStore\\\\FileRepository\\\\*\"\n)",
  "from": "now-15m",
  "interval": "10m",
  "enabled": true,
  "tags": [
    "Platform: Windows",
    "Data Source: Sysmon",
    "Performance: Normal",
    "Tactic: Credential Access",
    "Jarvis-Curated",
    "Domain: Endpoint",
    "Resources: Investigation Guide",
    "Noise: Low",
    "Homelab-Tuned",
    "Data Source: Elastic Defend",
    "OS: Windows",
    "Use Case: Threat Detection",
    "Rule Type: Event Correlation (EQL)"
  ],
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "technique": [
        {
          "id": "T1003",
          "name": "OS Credential Dumping",
          "reference": "https://attack.mitre.org/techniques/T1003/"
        },
        {
          "id": "T1556",
          "name": "Modify Authentication Process",
          "reference": "https://attack.mitre.org/techniques/T1556/",
          "subtechnique": [
            {
              "id": "T1556.007",
              "name": "Hybrid Identity",
              "reference": "https://attack.mitre.org/techniques/T1556/007/"
            }
          ]
        }
      ],
      "tactic": {
        "id": "TA0006",
        "name": "Credential Access",
        "reference": "https://attack.mitre.org/tactics/TA0006/"
      }
    },
    {
      "framework": "MITRE ATT&CK",
      "technique": [
        {
          "id": "T1574",
          "name": "Hijack Execution Flow",
          "reference": "https://attack.mitre.org/techniques/T1574/",
          "subtechnique": [
            {
              "id": "T1574.001",
