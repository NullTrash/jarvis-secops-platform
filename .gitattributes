# Set default behavior to automatically handle line endings
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to LF on checkout (preventing syntax errors on Linux hosts)
*.sh text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
